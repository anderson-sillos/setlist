# Projeto Supabase hospedado exclusivo para produção.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-prod.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_prod
# Client ID OAuth do tipo Web para o login nativo Google no Android e iOS.
# Configure o mesmo valor no ambiente production do EAS.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id-web.apps.googleusercontent.com
# Client ID OAuth do tipo iOS necessário para o login nativo em builds iOS.
# Configure o mesmo valor no ambiente production do EAS.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=seu-client-id-ios.apps.googleusercontent.com
# URL HTTPS pública usada nos links de convite compartilhados pelo aplicativo.
EXPO_PUBLIC_WEB_BASE_URL=https://setlistbr.app.br

# Opcional: Team ID Apple usado por app.config.ts e pelo workflow de Universal Links.
# SETLIST_IOS_TEAM_ID=ABCDE12345
