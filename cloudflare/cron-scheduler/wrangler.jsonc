{
  "$schema": "https://unpkg.com/wrangler@4.102.0/config-schema.json",
  "name": "setlist-cron-scheduler",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "SCHEDULER_ENABLED": "false",
  },
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "17 4,6 * * *",
      "27 4 * * *",
      "37 8 * * *",
    ],
  },
}
