{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-android": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-ios-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "SETLIST_NATIVE_GOOGLE_IOS": "1",
        "SETLIST_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.993309278725-t2bmmn8f99qr34qtnhus4q32ckh15eor"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios": {
      "extends": "preview",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "SETLIST_NATIVE_GOOGLE_IOS": "1",
        "SETLIST_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.993309278725-t2bmmn8f99qr34qtnhus4q32ckh15eor"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "SETLIST_NATIVE_GOOGLE_IOS": "1",
        "SETLIST_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.993309278725-t2bmmn8f99qr34qtnhus4q32ckh15eor"
      }
    },
    "production-ios-simulator": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production-android": {
      "extends": "production",
      "env": {
        "SETLIST_NATIVE_GOOGLE_ANDROID": "1",
        "SETLIST_NATIVE_GOOGLE_IOS": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-android-validation": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "SETLIST_NATIVE_GOOGLE_ANDROID": "1",
        "SETLIST_NATIVE_GOOGLE_IOS": "0"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
