# Projeto Supabase hospedado exclusivo para desenvolvimento.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-dev.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_dev
# Opcional: Client ID OAuth do tipo Web para o login nativo Google no Android.
# Sem esta variável, o app usa o OAuth pelo navegador.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-client-id-web.apps.googleusercontent.com
# URL HTTPS usada nos links de convite compartilhados pelo aplicativo.
EXPO_PUBLIC_WEB_BASE_URL=https://seu-dominio-dev.example.com

# Opcional: pausas para revisar visualmente o splash e o AuthGate (em ms).
# Remova ou deixe em branco no desenvolvimento normal; produção sempre ignora.
# EXPO_PUBLIC_AUTH_SPLASH_PREVIEW_MS=1500
# EXPO_PUBLIC_AUTH_GATE_PREVIEW_MS=4000
