{
  "name": "setlist",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:development:android": "npx --yes eas-cli@latest build --platform android --profile development-android",
    "build:preview:android": "npx --yes eas-cli@latest build --platform android --profile preview",
    "build:preview:ios": "npx --yes eas-cli@latest build --platform ios --profile preview",
    "build:preview:all": "npx --yes eas-cli@latest build --platform all --profile preview",
    "assets:icons": "node scripts/generate-app-icons.mjs",
    "links:prepare": "node scripts/prepare-link-associations.mjs",
    "supabase:check": "node scripts/check-supabase-connection.mjs",
    "supabase:check:eas": "node scripts/check-supabase-eas.mjs",
    "supabase:test": "npx --yes supabase@latest test db",
    "supabase:lint": "npx --yes supabase@latest db lint --local --schema public --fail-on error",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --coverage",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-native-community/netinfo": "9.3.10",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~49.0.0",
    "expo-constants": "~14.4.2",
    "expo-crypto": "~12.4.1",
    "expo-dev-client": "~2.4.13",
    "expo-file-system": "~15.4.5",
    "expo-keep-awake": "~12.3.0",
    "expo-linking": "~5.0.2",
    "expo-router": "~2.0.0",
    "expo-screen-orientation": "~6.0.6",
    "expo-secure-store": "~12.3.1",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "expo-web-browser": "~12.3.2",
    "lucide-react-native": "1.46.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.87.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-nitro-google-signin": "^2.2.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-svg": "13.9.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.19.6",
    "react-native-webview": "13.2.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.2",
    "@types/jest": "29.5.14",
    "@types/react": "~18.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~49.0.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.1.3",
    "@babel/core": "^7.20.0"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
