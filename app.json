{
  "expo": {
    "name": "Setlist",
    "slug": "setlist",
    "version": "0.1.0",
    "scheme": "setlist",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios", "web"],
    "ios": {
      "bundleIdentifier": "com.andersonsillos.setlist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andersonsillos.setlist",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1a76750-f4b4-4298-92ef-dfa333a33e73"
      }
    },
    "owner": "anderson-silloss-team"
  }
}
